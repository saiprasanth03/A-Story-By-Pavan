# ==============================================================================
# STUDIO OS - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure the values for your deployment.
# Do not commit .env to version control.

# ------------------------------------------------------------------------------
# APPLICATION & SERVER
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
APP_NAME=Studio OS
SITE_URL=http://localhost:5173
# CORS Allowed Origin (e.g. http://localhost:5173 or https://yourdomain.com, comma-separated)
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------------------
# MongoDB connection URI (local development fallback: mongodb://localhost:27017/studio-template)
MONGODB_URI=mongodb://localhost:27017/studio-template

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Strong secret key for signing admin JWT tokens
JWT_SECRET=your_jwt_secret_key_here

# ------------------------------------------------------------------------------
# ADMIN BOOTSTRAP
# ------------------------------------------------------------------------------
# Used to initialize the root super-admin account on initial server start.
# If ADMIN_PASSWORD is empty, automatic creation will be safely skipped.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=123456

# ------------------------------------------------------------------------------
# CLOUDINARY MEDIA STORAGE (Optional / Recommended for Media Uploads)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=studio_uploads

# ------------------------------------------------------------------------------
# EMAIL NOTIFICATIONS (Optional / Configurable via Resend or SMTP)
# ------------------------------------------------------------------------------
# Resend API Key (for transactional notifications via Resend)
RESEND_API_KEY=

# Standard SMTP Configuration (Alternative / Fallback)
SMTP_USER=
SMTP_PASS=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@example.com
REPLY_TO_EMAIL=contact@example.com

# ------------------------------------------------------------------------------
# GOOGLE DRIVE CLIENT GALLERY (Optional)
# ------------------------------------------------------------------------------
# Raw JSON string of Google Service Account Credentials
GOOGLE_SERVICE_ACCOUNT_JSON=
